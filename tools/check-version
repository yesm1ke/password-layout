#!/bin/bash
# Fails unless the PKGBUILD's pkgver, the one place the version is kept, is the
# given one and CHANGELOG.md has a section for it.
#
# Usage: tools/check-version 0.7.0   (a tag name such as v0.7.0 is fine)

set -euo pipefail
trap 'echo "check-version: failed at line $LINENO" >&2' ERR
cd "$(dirname "$0")/.."

want=${1:?usage: tools/check-version <version>}
want=${want#v}
status=0

found=$(sed -n 's/^pkgver=//p' packaging/arch/PKGBUILD)
[[ $found == "$want" ]] || { echo "PKGBUILD says ${found:-nothing}, expected $want" >&2; status=1; }
grep -q "^## $want " CHANGELOG.md || { echo "CHANGELOG.md has no \"## $want\" section" >&2; status=1; }

exit $status
