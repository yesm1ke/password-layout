post_install() {
  echo "Enable the service for your user (it starts with the graphical session):"
  echo "  systemctl --user enable --now password-layout-tty.service"
}

post_upgrade() {
  echo "Restart the service to run the new version:"
  echo "  systemctl --user restart password-layout-tty.service"
}

pre_remove() {
  echo "The service stays enabled for users who enabled it; to turn it off:"
  echo "  systemctl --user disable --now password-layout-tty.service"
}
