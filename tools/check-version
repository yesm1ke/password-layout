#!/bin/bash
# Fails unless every place that names the version agrees with the given one:
# the Makefile, the PKGBUILD, its .SRCINFO (version and tag) and CHANGELOG.md;
# and README.md must name the release key.
#
# Usage: tools/check-version 0.6.0   (a tag name such as v0.6.0 is fine)

set -euo pipefail
cd "$(dirname "$0")/.."

want=${1:?usage: tools/check-version <version>}
want=${want#v}
want=${want%%-*}
status=0

check() {
  local where=$1 found=$2
  if [[ $found != "$want" ]]; then
    echo "$where says ${found:-nothing}, expected $want" >&2
    status=1
  fi
}

check Makefile "$(sed -n 's/^VERSION := //p' Makefile)"
check PKGBUILD "$(sed -n 's/^pkgver=//p' packaging/arch/PKGBUILD)"
check .SRCINFO "$(sed -n 's/^\tpkgver = //p' packaging/arch/.SRCINFO)"
check ".SRCINFO source tag" "$(sed -n 's/.*#tag=v//p' packaging/arch/.SRCINFO)"
grep -q '@FINGERPRINT@' README.md && { echo "README.md still has the key fingerprint placeholder" >&2; status=1; }
readme=$(grep -oE 'releases/download/v[0-9.]+/password-layout-[0-9.]+-' README.md | head -1)
[[ -z $readme || $readme == "releases/download/v$want/password-layout-$want-" ]] ||
  [[ $(sed -n "s/^## $want — //p" CHANGELOG.md) == unreleased ]] ||
  { echo "README.md names $readme for pacman, expected $want" >&2; status=1; }
grep -q "^## $want " CHANGELOG.md || { echo "CHANGELOG.md has no \"## $want\" section" >&2; status=1; }

exit $status
