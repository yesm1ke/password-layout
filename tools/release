#!/bin/bash
# Releases version X.Y.Z in two runs of the same command.
#
#   1. On main before the release: sets the version everywhere, dates the
#      CHANGELOG section, commits on a branch release-X.Y.Z, pushes it and
#      opens a pull request. CI checks it like any other change.
#   2. On main after that pull request is merged: if CI passed on this commit,
#      tags it vX.Y.Z and pushes the tag; release.yml builds, signs and
#      publishes.
#
# Usage: tools/release X.Y.Z
#
# Before the first run: CHANGELOG.md has a "## X.Y.Z — unreleased" section.
# Tags are signed if git has a signing key.

set -euo pipefail
cd "$(dirname "$0")/.."

version=${1:?usage: tools/release <version>}
version=${version#v}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a version: $version" >&2; exit 1; }
tag=v$version

fail() { echo "release: $*" >&2; exit 1; }

[[ $(git branch --show-current) == main ]] || fail "not on main"
git diff --quiet && git diff --cached --quiet || fail "uncommitted changes"
git fetch --quiet origin
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || fail "main differs from origin/main"
git ls-remote --exit-code --tags origin "$tag" >/dev/null && fail "tag $tag exists"

if [[ $(sed -n 's/^VERSION := //p' Makefile) != "$version" ]]; then
  grep -q "^## $version — unreleased$" CHANGELOG.md ||
    fail "CHANGELOG.md needs a \"## $version — unreleased\" section"
  git switch --quiet -c "release-$version"
  sed -i "s/^VERSION := .*/VERSION := $version/" Makefile
  sed -i -e "s/^pkgver=.*/pkgver=$version/" -e "s/^pkgrel=.*/pkgrel=1/" packaging/arch/PKGBUILD
  (cd packaging/arch && makepkg --printsrcinfo > .SRCINFO)
  sed -i "s/^## $version — unreleased$/## $version — $(date +%F)/" CHANGELOG.md
  # The pacman URL in the README names the version, when there is one.
  sed -i -E "s|releases/download/v[0-9.]+/password-layout-[0-9.]+-[0-9]+-|releases/download/v$version/password-layout-$version-1-|" README.md
  tools/check-version "$version"
  git add Makefile packaging/arch/PKGBUILD packaging/arch/.SRCINFO CHANGELOG.md README.md
  git commit --quiet -m "Release $version"
  git push --quiet -u origin "release-$version"
  gh pr create --base main --head "release-$version" --title "Release $version" \
    --body "Sets the version to $version and dates its CHANGELOG section. After this is merged, \`tools/release $version\` on main tags it."
  git switch --quiet main
  echo "release: merge that pull request (rebase) once CI is green, then run tools/release $version again"
  exit 0
fi

# Second run: main is at the release commit. Tag it only if CI passed here.
tools/check-version "$version"
commit=$(git rev-parse HEAD)
runs=$(gh api "repos/{owner}/{repo}/commits/$commit/check-runs" \
  --jq '[.check_runs[] | .conclusion] | "\(length) \(all(. == "success"))"')
[[ $runs != "0 "* && $runs == *" true" ]] || fail "CI has not passed on $commit ($runs)"

if git config --get user.signingkey >/dev/null; then
  git tag -s -m "password-layout $version" "$tag"
else
  git tag -a -m "password-layout $version" "$tag"
fi
git push --quiet origin "$tag"
echo "release: $tag pushed; release.yml publishes it: https://github.com/yesm1ke/password-layout/actions"
