restart_hint() {
  echo "Restart fcitx5 so it loads the addon for password fields in graphical"
  echo "applications. On Omarchy:"
  echo "  systemctl --user restart omarchy-fcitx5.service"
  echo "Elsewhere:"
  echo "  fcitx5 -rd"
}

post_install() {
  echo "Enable the terminal watcher for your user (it starts with the graphical session):"
  echo "  systemctl --user enable --now password-layout-tty.service"
  restart_hint
}

post_upgrade() {
  echo "Restart the terminal watcher to run the new version:"
  echo "  systemctl --user restart password-layout-tty.service"
  restart_hint
}

pre_remove() {
  echo "The terminal watcher stays enabled for users who enabled it; to turn it off:"
  echo "  systemctl --user disable --now password-layout-tty.service"
  echo "Restart fcitx5 afterwards to unload the addon."
}
