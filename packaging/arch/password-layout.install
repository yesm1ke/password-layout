# Does for every logged-in user what they would otherwise do by hand: start the
# terminal watcher (the package enables it for everyone through
# graphical-session.target.wants) and restart fcitx5 so it loads the addon.
# Nothing here may fail the transaction: a user without a running session, or
# without fcitx5, is simply skipped.

unit=password-layout-tty.service

logged_in_users() {
  loginctl list-users --no-legend 2>/dev/null | while read -r uid user rest; do
    echo "$user"
  done
}

in_session() {
  user=$1
  shift
  systemctl --user --machine="$user@" "$@" >/dev/null 2>&1
}

restart_fcitx5() {
  user=$1
  # Omarchy runs fcitx5 as a service; elsewhere ask fcitx5 itself to restart.
  if in_session "$user" -q is-active omarchy-fcitx5.service; then
    in_session "$user" restart omarchy-fcitx5.service
  else
    systemd-run --user --machine="$user@" --wait --quiet --collect \
      busctl --user call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 Restart \
      >/dev/null 2>&1
  fi
}

apply_to_sessions() {
  action=$1
  for user in $(logged_in_users); do
    in_session "$user" daemon-reload
    if in_session "$user" "$action" "$unit"; then
      restart_fcitx5 "$user"
      echo "password-layout: running for $user (terminal watcher and fcitx5 addon)"
    fi
  done
}

post_install() {
  apply_to_sessions start
}

post_upgrade() {
  apply_to_sessions restart
}

pre_remove() {
  for user in $(logged_in_users); do
    in_session "$user" stop "$unit"
  done
}

post_remove() {
  for user in $(logged_in_users); do
    in_session "$user" daemon-reload
    restart_fcitx5 "$user"
  done
}
