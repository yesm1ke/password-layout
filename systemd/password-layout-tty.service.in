[Unit]
Description=Latin keyboard layout at terminal password prompts
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
ExecStart=@BINDIR@/password-layout watch-tty
Restart=always
RestartSec=2

# Sandboxing that works on any kernel. The service needs to read /proc and the
# modes of the user's terminals, talk to Hyprland and tmux over Unix sockets and
# run the tmux client; nothing else. Options that need user namespaces are in
# password-layout-tty.service.d/sandbox-namespaces.conf.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
KeyringMode=private
UMask=0077

[Install]
WantedBy=graphical-session.target
