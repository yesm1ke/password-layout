# Like other Arch packages, this one enables and restarts nothing: what to run
# is printed, and `password-layout doctor` tells what is still missing.

note() {
  echo "password-layout: $*"
}

post_install() {
  note "turn it on for your user:  systemctl --user enable --now password-layout-tty"
  note "for password fields in applications, restart fcitx5 (it loads the addon)"
  note "check the setup:           password-layout doctor"
}

post_upgrade() {
  # Up to 0.6 the package enabled the service for every user by itself.
  if (( $(vercmp "$2" 0.7.0) < 0 )); then
    note "the package no longer enables the service by itself; once, per user:"
    note "  systemctl --user enable password-layout-tty"
  fi
  note "running copies keep the old version until restarted:"
  note "  systemctl --user restart password-layout-tty, and restart fcitx5"
}

post_remove() {
  note "running copies stop at logout; to stop and disable now:"
  note "  systemctl --user disable --now password-layout-tty, and restart fcitx5"
}
