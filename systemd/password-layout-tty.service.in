[Unit]
Description=Latin keyboard layout at terminal password prompts
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
ExecStart=@BINDIR@/password-layout watch-tty
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
